# --- Accounts (required in production) ---------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
NUXT_SESSION_SECRET=

# --- Cloudflare Email Sending (magic links + feedback notifications) ----------
# In dev, emails print to the server console instead.
# The from-domain must be onboarded: npx wrangler email sending enable <domain>
NUXT_CF_ACCOUNT_ID=
NUXT_CF_EMAIL_TOKEN=
NUXT_EMAIL_FROM=
# Absolute origin of the deployed app — REQUIRED in production. Pins the
# domain in emailed links (a spoofed Host header can't redirect tokens) and is
# what API writes check the browser's Origin header against.
NUXT_APP_ORIGIN=

# --- Cloudflare Turnstile (optional bot check on the sign-in form) -----------
# Create a widget at dash.cloudflare.com → Turnstile. Leave both empty to skip
# the check (rate limits still apply). Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# --- Features (build-time) ------------------------------------------------------
# 0 compiles the feedback button, inbox, and API out of the bundle entirely.
NUXT_FEATURE_FEEDBACK=1

# --- Self-hosting knobs ---------------------------------------------------------
# 1 when a reverse proxy in front of you sets X-Forwarded-For (not needed on Cloudflare)
NUXT_TRUST_PROXY=
# sign-up ceiling for a public instance (default 250)
NUXT_MAX_USERS=

# --- Admin ---------------------------------------------------------------------
# Comma-separated emails that can open the feedback inbox and receive feedback
# notifications. Nobody is admin until this is set.
NUXT_ADMIN_EMAILS=

# --- Cloudflare deployment (make deploy) ----------------------------------------
# Create these once in your own account, then paste the ids here:
#   npx wrangler d1 create startrr-db
#   npx wrangler kv namespace create startrr-kv
#   npx wrangler kv namespace create startrr-cache
#   npx wrangler r2 bucket create startrr-blob
NUXT_CF_WORKER_NAME=startrr
NUXT_CF_D1_DATABASE_NAME=startrr-db
NUXT_CF_D1_DATABASE_ID=
NUXT_CF_KV_ID=
NUXT_CF_KV_CACHE_ID=
NUXT_CF_R2_BUCKET=startrr-blob
